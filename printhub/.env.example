# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# Токен от @BotFather. НИКОГДА не коммитить и никому не показывать: этим ключом
# проверяется личность пользователей веб-аппа — тот, у кого он есть, войдёт под
# любым из них. Если токен где-то засветился, отзовите его: /revoke в @BotFather.
PRINTHUB_BOT_TOKEN=

# Ключ для подписи наших токенов сессии. Сгенерировать:
#   python -c "import secrets; print(secrets.token_hex(32))"
PRINTHUB_SECRET_KEY=

# dev — для разработки, prod — боевой сервер (там часть послаблений запрещена).
PRINTHUB_ENV=dev

# Куда класть базу и файлы.
PRINTHUB_DATA_DIR=data

# Публичный HTTPS-адрес веб-аппа — телеграм открывает только такой.
PRINTHUB_WEBAPP_URL=

# Вход без телеграма, для работы в обычном браузере.
# Включает вход кому угодно под любым номером. Вместе с PRINTHUB_ENV=prod
# процесс не запустится — это намеренно.
PRINTHUB_DEV_LOGIN=1

# Кто видит админку и правит прайс — номера в телеграме через запятую.
# Свой номер можно посмотреть в профиле приложения.
PRINTHUB_ADMIN_IDS=
